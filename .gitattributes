# explicitly mark lock files as generated to collapse in diffs
Gemfile.lock linguist-generated
package-lock.json linguist-generated

# Keep the cross-platform working tree compatible with Linux containers.
* text=auto eol=lf

# Windows-native scripts keep their platform line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve byte-exact BIM fixtures.
*.ifc -text
